# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot API Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_channel_or_group_id_here

# Instagram Meta Graph API Configuration
INSTAGRAM_ACCESS_TOKEN=your_instagram_meta_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here

# Facebook Graph API Configuration
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# Pinterest API v5 Configuration
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token_here
PINTEREST_BOARD_ID=your_pinterest_board_id_here

# YouTube Data API Configuration
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here

# Default Affiliate Tracking Tag (optional)
DEFAULT_AFFILIATE_TAG=tag=mydeals-20

# Secret token for protecting /api/cron/publish webhook
CRON_SECRET=your_random_secret_string_here
